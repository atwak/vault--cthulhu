views:
  - type: table
    name: все записи
  - type: table
    name: предметы
    filters:
      and:
        - категория == "предмет"
    order:
      - file.name
      - носитель
      - сводка
      - найдено
      - статус
    sort:
      - property: file.name
        direction: ASC
      - property: статус
        direction: ASC
    columnSize:
      note.носитель: 208
      note.сводка: 242
      note.найдено: 161
  - type: table
    name: персоны
    filters:
      and:
        - file.folder.startsWith("словарь/персоны")
    order:
      - file.name
      - аспект
      - sets
      - статус
      - координаты
      - телефон
    columnSize:
      note.аспект: 201
  - type: table
    name: заклинания
    filters:
      and:
        - категория == "заклинание"
    order:
      - file.name
      - носитель
      - сводка
      - найдено
      - статус
    sort:
      - property: file.name
        direction: ASC
      - property: статус
        direction: ASC
    columnSize:
      note.носитель: 208
      note.сводка: 242
      note.найдено: 161
  - type: table
    name: группы
    filters:
      and:
        - "!sets.isEmpty()"
    order:
      - file.name
      - sets
    sort:
      - property: sets
        direction: ASC
